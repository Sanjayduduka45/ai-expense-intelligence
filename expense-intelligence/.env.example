# ==============================================================================
# AI Expense Intelligence — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development.
# In production (Render / Railway / Streamlit Cloud), configure these environment
# variables directly in your platform's dashboard / settings.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Required on Render / Railway)
# ------------------------------------------------------------------------------

# Application Environment: 'development', 'production', or 'testing'
APP_ENV=development

# Logging Level: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=INFO

# Server Bind Address & Port
# Note: Production platforms like Render & Railway automatically provide the PORT variable.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# PORT=8000

# Allowed CORS Origins (comma-separated list or JSON array)
# IMPORTANT: In production, specify your exact Streamlit frontend URL. Wildcard '*' is blocked in production mode.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8501,http://localhost:8501

# Google Gemini API Key (BACKEND ONLY — Never expose to Streamlit or client-side code)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Ingestion Constraints (Optional overrides)
# MAX_UPLOAD_SIZE_BYTES=10485760
# MAX_UPLOAD_ROWS=10000

# ------------------------------------------------------------------------------
# Frontend Configuration (Required on Streamlit Cloud)
# ------------------------------------------------------------------------------

# Base URL of the deployed FastAPI Backend
# Development default: http://127.0.0.1:8000
# Production example: https://ai-expense-backend.onrender.com
BACKEND_URL=http://127.0.0.1:8000
